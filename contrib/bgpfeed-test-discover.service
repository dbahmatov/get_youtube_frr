[Unit]
Description=bgpfeed test discovery (no FRR changes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/bgpfeed-test
Environment=PYTHONPATH=/opt/bgpfeed-test
ExecStart=/opt/bgpfeed-test/venv/bin/python -m bgpfeed discover --config /opt/bgpfeed-test/config-v2.yaml
